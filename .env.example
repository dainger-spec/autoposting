# ── Обязательные параметры ──────────────────────────────────────────

# Данные приложения: https://my.telegram.org → API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Токен бота для управления: создайте бота у @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ── Необязательные параметры ────────────────────────────────────────

# Номер телефона вашего аккаунта (если пусто — спросит при первом запуске)
PHONE=

# Только для хостинга без консоли (bothost.ru и т.п.): строка сессии,
# которую выдаёт команда python login.py. Дома оставьте пустым.
SESSION_STRING=

# Чат по умолчанию для постов: @username, ссылка https://t.me/...,
# ID чата (-100...) или me (Избранное). Можно выбрать и в боте для каждого поста.
DEFAULT_CHAT=

# Канал, куда пост публикуется один раз, а затем пересылается из него в чат
# по расписанию. Удобнее выбрать в боте: «⚙️ Настройки». Пусто — без канала.
CHANNEL=

# Часовой пояс расписания (Europe/Moscow, Europe/Kiev, Asia/Almaty, ...)
TIMEZONE=Europe/Moscow

# Кто ещё может управлять ботом (Telegram ID через запятую).
# Владелец аккаунта, с которого идут посты, имеет доступ всегда.
ADMIN_IDS=

# Присылать в бот уведомление после каждой успешной публикации (true/false)
NOTIFY_ON_SUCCESS=true

# Если скрипт был выключен в момент публикации: сколько минут после
# назначенного времени пост ещё можно отправить (дальше — пропускается)
LATE_SEND_MINUTES=10

# Случайная пауза между отправками в разные чаты, в секундах (диапазон «от-до»).
# Не шлите пачкой: так меньше шансов упереться в лимиты Telegram.
PAUSE_BETWEEN_CHATS=5-15

# Файл с постами (можно редактировать вручную, бот подхватит изменения).
# По умолчанию — posts.json в папке проекта (или в DATA_DIR, если она задана).
POSTS_FILE=

# Папка для данных: сессии, отметки об отправке, медиа. На хостинге укажите
# постоянную папку (на bothost.ru её задаёт сама платформа: /app/data) —
# тогда и posts.json по умолчанию хранится в ней.
DATA_DIR=
